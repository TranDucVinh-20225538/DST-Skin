+def _l2_tracka(x: np.ndarray) -> np.ndarray:
+    # DST-Skin OODScorer.l2_normalize: x / (||x|| + 1e-8)
+    x = _as_f64(x)
+    return x / (np.linalg.norm(x, axis=1, keepdims=True) + 1e-8)
+
+
+@register_scorer("knn_mean_cosine")
+class KNNMeanCosineScorer:
+    """Track A k-NN (DST-Skin OODScorer.score_knn): L2-normalise (x / (||x|| + 1e-8)),
+    ``score = -mean cosine distance to the k nearest fit samples`` (sklearn
+    NearestNeighbors, metric="cosine", algorithm="auto"). ``k`` capped at n_fit."""
+
+    def __init__(self, k: int = 50) -> None:
+        self.k = k
+
+    def fit(self, features: np.ndarray, labels: Optional[np.ndarray] = None) -> "KNNMeanCosineScorer":
+        x = _l2_tracka(features)
+        self.k_ = int(min(self.k, x.shape[0]))
+        self.nn_ = NearestNeighbors(n_neighbors=self.k_, metric="cosine", algorithm="auto").fit(x)
+        return self
+
+    def score(self, features: np.ndarray) -> np.ndarray:
+        dist, _ = self.nn_.kneighbors(_l2_tracka(features), n_neighbors=self.k_)
+        return -dist.mean(axis=1)
+
+
+@register_scorer("mahalanobis_l2")
+class MahalanobisL2Scorer:
+    """Track A Mahalanobis (DST-Skin OODScorer): LedoitWolf() (default, centring at the
+    mean) on L2-normalised float64 features (x / (||x|| + 1e-8)), one class-agnostic
+    mean; ``score = -sqrt(max((x - mu)^T P (x - mu), 0))`` as in Track A."""
+
+    def fit(self, features: np.ndarray, labels: Optional[np.ndarray] = None) -> "MahalanobisL2Scorer":
+        lw = LedoitWolf().fit(_l2_tracka(features))
+        self.mu_ = np.asarray(lw.location_, dtype=np.float64)
+        self.precision_ = np.asarray(lw.precision_, dtype=np.float64)
+        return self
+
+    def score(self, features: np.ndarray) -> np.ndarray:
+        diff = _l2_tracka(features) - self.mu_
+        return -np.sqrt(np.maximum(np.sum((diff @ self.precision_) * diff, axis=1), 0.0))
+
