+"""Track A scorer definitions (DST-Skin OODScorer) vs the package scorers knn_mean_cosine,
+mahalanobis_l2 and ViMScorer(head, dim = D - C), on one real cell.
+
+Needs DSTSKIN_ROOT (DST-Skin checkout, for src.utils.scoring) and TRACKA_CELL (an R3 item-1 input
+.npz with a sibling <cell>_head.npz); skipped otherwise.
+"""
+import os
+import sys
+
+import numpy as np
+import pytest
+
+from crossfit_ood import ViMScorer, get_scorer
+
+ROOT, CELL = os.environ.get("DSTSKIN_ROOT"), os.environ.get("TRACKA_CELL")
+pytestmark = pytest.mark.skipif(not (ROOT and CELL), reason="needs DSTSKIN_ROOT and TRACKA_CELL")
+
+
+@pytest.fixture(scope="module")
+def tracka():
+    sys.path.insert(0, ROOT)
+    from src.utils.scoring import OODScorer
+    z = np.load(CELL, allow_pickle=True)
+    h = np.load(CELL.replace(".npz", "_head.npz"))
+    w, b = h["weight"], h["bias"]
+    xtr = np.asarray(z["features_train"], np.float64)
+    xq = np.concatenate([z["features_id_eval"], z["features_ood"]]).astype(np.float64)
+    sc = OODScorer(k_nearest=50, use_react=False, use_vim=True, vim_dim=None)
+    sc.fit(xtr, train_logits=xtr @ w.T + b, fc_weight=w, fc_bias=b)
+    ref = sc.get_all_scores(xq @ w.T + b, xq)
+    return xtr, xq, w, b, ref
+
+
+def test_knn_mean_cosine(tracka):
+    xtr, xq, _, _, ref = tracka
+    s = get_scorer("knn_mean_cosine", k=50).fit(xtr).score(xq)
+    np.testing.assert_allclose(s, ref["knn"], rtol=0, atol=1e-9)
+
+
+def test_mahalanobis_l2(tracka):
+    xtr, xq, _, _, ref = tracka
+    s = get_scorer("mahalanobis_l2").fit(xtr).score(xq)
+    np.testing.assert_allclose(s, ref["mahalanobis"], rtol=1e-9, atol=1e-9)
+
+
+def test_vim_tracka_dim(tracka):
+    # Track A stores the ViM parameters and the score in float32 -> float32-level tolerance
+    xtr, xq, w, b, ref = tracka
+    s = ViMScorer(weight=w, bias=b, dim=xtr.shape[1] - w.shape[0]).fit(xtr).score(xq)
+    np.testing.assert_allclose(s, ref["vim"], rtol=2e-4, atol=2e-4)
+    assert np.mean(np.argsort(np.argsort(s)) == np.argsort(np.argsort(ref["vim"]))) > 0.99
